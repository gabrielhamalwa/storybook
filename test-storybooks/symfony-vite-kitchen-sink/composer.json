{
  "name": "storybook/symfony-vite-kitchen-sink",
  "description": "Storybook Symfony/Twig kitchen-sink integration test",
  "type": "project",
  "license": "MIT",
  "minimum-stability": "stable",
  "prefer-stable": true,
  "require": {
    "php": ">=8.2",
    "symfony/console": "^7.0",
    "symfony/dotenv": "^7.0",
    "symfony/flex": "^2.4",
    "symfony/framework-bundle": "^7.0",
    "symfony/runtime": "^7.0",
    "symfony/twig-bundle": "^7.0",
    "symfony/ux-live-component": "^2.0",
    "symfony/ux-twig-component": "^2.0",
    "symfony/stimulus-bundle": "^2.0",
    "symfony/yaml": "^7.0",
    "pentatrion/vite-bundle": "^8.0",
    "storybook/symfony-bundle": "@dev"
  },
  "require-dev": {
    "symfony/web-profiler-bundle": "^7.0"
  },
  "config": {
    "allow-plugins": {
      "symfony/flex": true,
      "symfony/runtime": true
    },
    "sort-packages": true
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "repositories": [
    {
      "type": "path",
      "url": "../../../storybook-symfony-bundle",
      "options": {
        "symlink": true
      }
    }
  ],
  "scripts": {
    "auto-scripts": {
      "cache:clear": "symfony-cmd",
      "assets:install %PUBLIC_DIR%": "symfony-cmd"
    }
  }
}
